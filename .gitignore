# --- sidequest backup .gitignore (managed) ---
node_modules/
dist/
build/
.next/
.turbo/
*.sst
*.log
SITE/site.zip
*.mp4
*.mov
# .env is intentionally NOT ignored (disaster recovery)
# Windows reserved device names — git cannot index a file literally
# named e.g. 'nul' (stray '> nul' redirects). Skip them so add -A works.
[Nn][Uu][Ll]
[Cc][Oo][Nn]
[Pp][Rr][Nn]
[Aa][Uu][Xx]
